# ─────────────────────────────────────────────────────────────────────────────
# OmniGraph — .env.example
#
# Copy this file to .env and fill in your own values.
# The .env file is gitignored and should never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub ───────────────────────────────────────────────────────────────────
# A GitHub Personal Access Token with:
#   - repo (read access to source code and PR diffs)
#   - write:discussion (to post PR comments)
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# ── Repo → Service ID mapping ────────────────────────────────────────────────
# A JSON object mapping each GitHub repository to a unique service identifier.
# The service ID is how OmniGraph tracks that service in the Neo4j graph.
#
# Format: {"owner/repo-name": "unique_service_id", ...}
# Example (replace with your own repos):
OMNIGRAPH_REPOS={"your-org/your-python-service": "svc_python", "your-org/your-node-service": "svc_node"}

# ── Neo4j ────────────────────────────────────────────────────────────────────
# If you use the bundled docker-compose.neo4j.yml, the defaults below work
# out of the box. Only change these if you run your own Neo4j instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=omnigraph_secret_123
